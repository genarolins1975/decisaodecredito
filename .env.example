# Copie para .env e ajuste. Nunca comite segredos.
NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgres://curso:curso@localhost:5432/curso_dev
# Chave de 32 bytes em base64 para cifrar tokens OAuth no banco: openssl rand -base64 32
APP_SECRET=troque-esta-chave
# Armazenamento de arquivos: local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# Para S3 ou compatível (Supabase Storage, Cloudflare R2, MinIO)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# E-mail: gmail | outbox (fila sem envio, apenas desenvolvimento/homologação)
EMAIL_PROVIDER=outbox
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Remetente exibido nos convites (deve ser a conta Gmail conectada)
EMAIL_FROM_NAME=Prof. Genaro Dueire Lins
