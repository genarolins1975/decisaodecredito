{
  "name": "plataforma-decisao-de-credito",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma acadêmica do curso Laboratório de Decisão de Crédito (Prof. Genaro Dueire Lins, FGV)",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "vercel-build": "bash scripts/vercel-build.sh",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "lint:tracos": "node scripts/lint-tracos-cascas.mjs",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --tsconfig scripts/tsconfig.json scripts/migrate.ts",
    "db:seed": "tsx --tsconfig scripts/tsconfig.json scripts/seed.ts",
    "db:reset": "tsx --tsconfig scripts/tsconfig.json scripts/reset.ts",
    "content:import": "tsx --tsconfig scripts/tsconfig.json scripts/import-content.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "backup": "bash scripts/backup.sh",
    "restore": "bash scripts/restore.sh"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1134.0",
    "@aws-sdk/s3-request-presigner": "3.1134.0",
    "@node-rs/argon2": "2.2.1",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "katex": "0.18.7",
    "nanoid": "6.0.1",
    "next": "16.3.5",
    "papaparse": "5.7.0",
    "pg": "8.23.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/jsdom": "27.0.0",
    "@types/katex": "0.16.8",
    "@types/node": "22.20.3",
    "@types/papaparse": "5.5.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.11.1",
    "dompurify": "3.4.15",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
